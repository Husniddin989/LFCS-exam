        content: `
## Storage Management Lab

### Lab 1: Create and Mount Filesystem (10 min)

\`\`\`bash
# 1. Identify available disk
lsblk
# Assume /dev/sdb is available

# 2. Create partition
sudo parted /dev/sdb mklabel gpt
sudo parted /dev/sdb mkpart primary ext4 0% 100%

# 3. Create filesystem
sudo mkfs.ext4 -L testdata /dev/sdb1

# 4. Create mount point and mount
sudo mkdir /mnt/testdata
sudo mount /dev/sdb1 /mnt/testdata

# 5. Verify
df -h /mnt/testdata
lsblk /dev/sdb

# 6. Test write
echo "test" | sudo tee /mnt/testdata/test.txt
cat /mnt/testdata/test.txt

# Cleanup
sudo umount /mnt/testdata
\`\`\`

### Lab 2: LVM Complete Workflow (15 min)

\`\`\`bash
# 1. Create PVs
sudo pvcreate /dev/sdb /dev/sdc
sudo pvs

# 2. Create VG
sudo vgcreate lab_vg /dev/sdb /dev/sdc
sudo vgs

# 3. Create LVs
sudo lvcreate -n lab_lv1 -L 5G lab_vg
sudo lvcreate -n lab_lv2 -l 50%FREE lab_vg
sudo lvs

# 4. Create filesystems
sudo mkfs.ext4 /dev/lab_vg/lab_lv1
sudo mkfs.xfs /dev/lab_vg/lab_lv2

# 5. Mount
sudo mkdir -p /mnt/lab{1,2}
sudo mount /dev/lab_vg/lab_lv1 /mnt/lab1
sudo mount /dev/lab_vg/lab_lv2 /mnt/lab2

# 6. Verify
df -h | grep lab
lvs

# 7. Extend LV
sudo lvextend -L +2G -r /dev/lab_vg/lab_lv1
df -h /mnt/lab1

# 8. Create snapshot
echo "original data" | sudo tee /mnt/lab1/data.txt
sudo lvcreate -s -n lab_lv1_snap -L 1G /dev/lab_vg/lab_lv1
sudo lvs

# 9. Modify original
echo "modified data" | sudo tee /mnt/lab1/data.txt

# 10. Mount and view snapshot
sudo mkdir /mnt/lab1_snap
sudo mount /dev/lab_vg/lab_lv1_snap /mnt/lab1_snap
cat /mnt/lab1_snap/data.txt  # Should show "original data"
cat /mnt/lab1/data.txt        # Should show "modified data"

# Cleanup
sudo umount /mnt/lab{1,2}
sudo umount /mnt/lab1_snap
sudo lvremove -f /dev/lab_vg/lab_lv1_snap
sudo lvremove -f /dev/lab_vg/lab_lv1
sudo lvremove -f /dev/lab_vg/lab_lv2
sudo vgremove lab_vg
sudo pvremove /dev/sdb /dev/sdc
\`\`\`

### Lab 3: fstab Configuration (10 min)

\`\`\`bash
# 1. Create test filesystem
sudo mkfs.ext4 -L fstab_test /dev/sdb1

# 2. Get UUID
UUID=$(sudo blkid /dev/sdb1 | grep -o 'UUID="[^"]*"' | cut -d'"' -f2)
echo "UUID: $UUID"

# 3. Backup fstab
sudo cp /etc/fstab /etc/fstab.backup

# 4. Add entry
echo "UUID=$UUID  /mnt/fstab_test  ext4  defaults,noatime  0  2" | sudo tee -a /etc/fstab

# 5. Create mount point
sudo mkdir /mnt/fstab_test

# 6. Test without mounting
sudo mount -a --fake -v

# 7. Mount all
sudo mount -a

# 8. Verify
df -h /mnt/fstab_test
mount | grep fstab_test

# Cleanup
sudo umount /mnt/fstab_test
sudo sed -i '/fstab_test/d' /etc/fstab
sudo cp /etc/fstab.backup /etc/fstab
\`\`\`

### Lab 4: Swap Management (10 min)

\`\`\`bash
# 1. Check current swap
free -h
swapon --show

# 2. Create swap file (1GB)
sudo fallocate -l 1G /swapfile_lab
sudo chmod 600 /swapfile_lab

# 3. Format as swap
sudo mkswap /swapfile_lab

# 4. Enable swap
sudo swapon /swapfile_lab

# 5. Verify
free -h
swapon --show

# 6. Check swappiness
cat /proc/sys/vm/swappiness

# 7. Set swappiness temporarily
sudo sysctl vm.swappiness=10
cat /proc/sys/vm/swappiness

# 8. Test fstab entry (don't add permanently for lab)
echo '/swapfile_lab  none  swap  sw  0  0' | sudo tee -a /etc/fstab
sudo swapoff /swapfile_lab
sudo swapon -a
free -h

# Cleanup
sudo swapoff /swapfile_lab
sudo sed -i '/swapfile_lab/d' /etc/fstab
sudo rm /swapfile_lab
sudo sysctl vm.swappiness=60
\`\`\`

### Lab 5: Troubleshooting Simulation (5 min)

\`\`\`bash
# Simulate disk full scenario

# 1. Create small filesystem
sudo fallocate -l 100M /tmp/testdisk.img
sudo mkfs.ext4 /tmp/testdisk.img
sudo mkdir /mnt/testdisk
sudo mount /tmp/testdisk.img /mnt/testdisk

# 2. Fill it up
sudo dd if=/dev/zero of=/mnt/testdisk/bigfile bs=1M count=95

# 3. Check space
df -h /mnt/testdisk
# Should show ~95% full

# 4. Find large files
sudo du -sh /mnt/testdisk/*
sudo find /mnt/testdisk -type f -size +50M -exec ls -lh {} \\;

# 5. Clean up
sudo rm /mnt/testdisk/bigfile
df -h /mnt/testdisk

# Cleanup
sudo umount /mnt/testdisk
sudo rm /tmp/testdisk.img
\`\`\`

### Validation

\`\`\`bash
echo "=== Storage Management Skills Check ==="

# 1. Can you create and mount a filesystem?
echo "Filesystems:"
df -hT | grep -E 'Filesystem|ext4|xfs'

# 2. Can you work with LVM?
echo "LVM Status:"
sudo pvs 2>/dev/null && sudo vgs 2>/dev/null && sudo lvs 2>/dev/null || echo "No LVM configured"

# 3. Can you manage swap?
echo "Swap Status:"
free -h | grep -i swap
swapon --show

# 4. Can you view fstab?
echo "fstab Entries:"
grep -v '^#' /etc/fstab | grep -v '^$'

echo "=== Lab Complete ==="
\`\`\`
        `,
