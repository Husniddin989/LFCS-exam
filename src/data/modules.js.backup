### Validation & Cleanup

\`\`\`bash
# Verify learned skills
echo "=== Validation ==="

# 1. Can you list all running services?
systemctl list-units --type=service --state=running

# 2. Can you find the 5 most memory-intensive processes?
ps aux --sort=-%mem | head -6

# 3. Can you list all enabled timers?
systemctl list-timers

# 4. Can you view yesterday's logs for a service?
sudo journalctl -u sshd --since yesterday --until today

# Cleanup
sudo systemctl stop system-monitor.service 2>/dev/null
sudo systemctl disable system-monitor.service 2>/dev/null
sudo rm -f /etc/systemd/system/system-monitor.service
sudo rm -f /etc/cron.d/log-cleanup
sudo rm -f /usr/local/bin/system-monitor.sh
sudo rm -f /usr/local/bin/log-cleanup.sh
sudo rm -rf /var/log/myapp
sudo systemctl daemon-reload

echo "Lab cleanup complete!"
