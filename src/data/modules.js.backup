          { cmd: "lvs && vgs && pvs", desc: "View all LVM components" },
          { cmd: "df -h", desc: "Check disk usage" },
          { cmd: "lsblk", desc: "View block devices" },
          { cmd: "mount -a", desc: "Mount all from fstab" }
        ]
